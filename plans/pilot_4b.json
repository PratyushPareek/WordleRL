{
  "description": "Measure Qwen3-4B on an L4 before committing to long runs: full no-thinking baseline (315 held-out words), a small thinking baseline (8 words), and short GRPO runs in each mode for step timings and memory. Thinking items are kept small: on an L4 only ~3 thinking games fit in the KV cache at once.",
  "items": [
    {"name": "baseline-qwen3-4b-nothink",
     "args": ["--model", "Qwen/Qwen3-4B", "--eval-only", "--eval-size", "315", "--eval-batch-size", "32",
              "--vllm-gpu-memory-utilization", "0.55"]},
    {"name": "pilot-baseline-qwen3-4b-think",
     "args": ["--model", "Qwen/Qwen3-4B", "--thinking", "--eval-only", "--eval-size", "8", "--eval-batch-size", "8",
              "--vllm-gpu-memory-utilization", "0.55"]},
    {"name": "pilot-train-qwen3-4b-nothink",
     "args": ["--model", "Qwen/Qwen3-4B", "--max-steps", "3", "--eval-size", "0", "--save-steps", "1000",
              "--vllm-gpu-memory-utilization", "0.45"]},
    {"name": "pilot-train-qwen3-4b-nothink-bs1",
     "args": ["--model", "Qwen/Qwen3-4B", "--max-steps", "3", "--eval-size", "0", "--save-steps", "1000",
              "--per-device-train-batch-size", "1", "--gradient-accumulation-steps", "16",
              "--vllm-gpu-memory-utilization", "0.45"]},
    {"name": "pilot-train-qwen3-4b-think",
     "args": ["--model", "Qwen/Qwen3-4B", "--thinking", "--max-steps", "1", "--eval-size", "0", "--save-steps", "1000",
              "--num-generations", "4", "--per-device-train-batch-size", "1", "--gradient-accumulation-steps", "8",
              "--vllm-gpu-memory-utilization", "0.45"]}
  ]
}
