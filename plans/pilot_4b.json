{
  "description": "Measure Qwen3-4B on an L4 before the thinking-on training run: baselines with thinking off and on, on the same 20 held-out words used for every evaluation during training (tokens per game, win rate), and one thinking GRPO step (time and memory). On an L4 only ~3 thinking games fit in the KV cache at once.",
  "items": [
    {"name": "baseline-qwen3-4b-nothink",
     "args": ["--model", "Qwen/Qwen3-4B", "--eval-only", "--eval-size", "20", "--eval-batch-size", "20",
              "--vllm-gpu-memory-utilization", "0.55"]},
    {"name": "baseline-qwen3-4b-think",
     "args": ["--model", "Qwen/Qwen3-4B", "--thinking", "--eval-only", "--eval-size", "20", "--eval-batch-size", "20",
              "--vllm-gpu-memory-utilization", "0.55"]},
    {"name": "pilot-train-qwen3-4b-think",
     "args": ["--model", "Qwen/Qwen3-4B", "--thinking", "--max-steps", "1", "--eval-size", "0", "--save-steps", "1000",
              "--num-generations", "4", "--per-device-train-batch-size", "1", "--gradient-accumulation-steps", "8",
              "--vllm-gpu-memory-utilization", "0.45"]}
  ]
}
